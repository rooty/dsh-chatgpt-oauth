{
  "name": "@local/dsh-chatgpt-oauth",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Minimal ChatGPT OAuth sign-in for DSH's native openai-codex provider",
  "type": "module",
  "engines": { "dsh": "0.2.1-rc.5" },
  "exports": { ".": "./index.js", "./client": "./client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["LICENSE", "index.js", "client.js", "cordis.patch.yml", "README.md", "locale/*.json", "icon.svg"],
  "scripts": { "test": "node --test tests/*.test.mjs", "check": "node --check index.js && node --check client.js && node --test tests/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings-models", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
